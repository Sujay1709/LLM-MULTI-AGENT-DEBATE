# Select one provider and place its key in a local .env file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Ollama normally needs no key. Example model: ollama/llama3.2
OLLAMA_API_BASE=http://localhost:11434

# Used when --model is omitted. The fake model makes the project runnable offline.
MODEL=fake/deterministic

